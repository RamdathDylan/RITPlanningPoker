    "check:env-files": "node tooling/env-files.js",
    "migrate": "npm run migrate --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  }
}
