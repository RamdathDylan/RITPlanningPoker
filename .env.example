# Copy this file to .env and replace every placeholder. Never commit .env.
# All values below are placeholders, not real credentials.

# development | test | production
NODE_ENV=development

# Port the Node server listens on
PORT=3000

# The only origin allowed by CORS (the React app's URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Local Postgres (docker compose) ---
# Superuser, used only by the container to create roles on first start
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-superuser
# Host port for local Postgres (change if 5432 is taken)
POSTGRES_PORT=5432
# Passwords for the two application roles created by docker/initdb
PP_MIGRATOR_PASSWORD=replace-me-migrator
PP_APP_PASSWORD=replace-me-app

# --- Connection strings (passwords must match the values above) ---
# App connects as the least-privilege role (data access only)
DATABASE_URL=postgres://pp_app:replace-me-app@localhost:5432/planning_poker
# Migrations run as the schema owner
MIGRATION_DATABASE_URL=postgres://pp_migrator:replace-me-migrator@localhost:5432/planning_poker
# Test database, same two roles
TEST_DATABASE_URL=postgres://pp_app:replace-me-app@localhost:5432/planning_poker_test
TEST_MIGRATION_DATABASE_URL=postgres://pp_migrator:replace-me-migrator@localhost:5432/planning_poker_test

# --- Optional (defaults shown) ---
# Use SSL for the database connection (true when the database is on another machine)
DATABASE_SSL=false
# Rate limits per client IP. Joins are generous because a whole class may share one IP.
RATE_LIMIT_ROOM_CREATES_PER_10_MIN=5
RATE_LIMIT_JOINS_PER_MIN=60
RATE_LIMIT_EXPORTS_PER_MIN=10
# Maximum rooms held in memory at once
MAX_LIVE_ROOMS=200
# How long the facilitator may be disconnected before control passes on (milliseconds)
HANDOFF_MS=60000
# Folder with the built client (client/dist). Leave unset in development; Docker sets it.
# CLIENT_DIST_DIR=/app/client/dist

# --- Production (compose.prod.yml on the server) ---
# Public domain name; Caddy gets its HTTPS certificate for it. CLIENT_ORIGIN becomes https://DOMAIN.
DOMAIN=poker.example.com
# Optional: pin a specific published image instead of :latest (e.g. for a rollback).
# APP_IMAGE=ghcr.io/ramdathdylan/ritplanningpoker:<commit-sha>
