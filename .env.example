# Copy this file to .env and replace every placeholder. Never commit .env.
# All values below are placeholders, not real credentials.

# development | test | production
NODE_ENV=development

# Port the Node server listens on
PORT=3000

# The only origin allowed by CORS (the React app's URL)
CLIENT_ORIGIN=http://localhost:5173

# Connection string for the app's least-privilege database user (pp_app)
DATABASE_URL=postgres://pp_app:replace-me@localhost:5432/planning_poker
